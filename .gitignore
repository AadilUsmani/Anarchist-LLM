# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.obj
*.o
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments & Secrets
.env
.env.*
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# PyTorch / ML Model Weights & Large Binary Checkpoints (>100MB)
models/
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.onnx
*.h5
*.tflite
*.joblib
*.pkl.gz

# Local SQLite databases & runtime data
*.db
*.sqlite
*.sqlite3
chat_history.db
experiment_history.db

# Logs & Monitoring
*.log
runs/*.log
wandb/
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

